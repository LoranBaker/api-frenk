            "type": "string",
            "nullable": true
          },
          "environment": {
            "type": "string",
            "nullable": true
          },
          "haltAnswers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HaltAnswer"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
