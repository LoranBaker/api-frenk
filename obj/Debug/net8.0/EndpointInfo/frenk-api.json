              "type": "string"
            },
            "nullable": true
          },
          "habitDuration": {
            "type": "string",
            "nullable": true
          },
          "identityFraming": {
            "type": "string",
            "nullable": true
          },
          "futureSelfText": {
            "type": "string",
            "nullable": true
          },
